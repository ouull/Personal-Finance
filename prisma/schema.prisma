generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String             @unique
  password          String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  language          String             @default("ID")
  image             String?
  accounts          Account[]
  budgets           Budget[]
  categories        Category[]
  goals             Goal[]
  investments       Investment[]
  loans             Loan[]
  merchants         Merchant[]
  mobileSessions    MobileSession[]
  notifications     Notification[]
  recurringPayments RecurringPayment[]
  transactions      Transaction[]
}

model Account {
  id               String                  @id @default(cuid())
  userId           String
  name             String
  type             String
  balance          Decimal                 @default(0.0)
  currency         String                  @default("IDR")
  isActive         Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  isSystem         Boolean                 @default(false)
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  investmentTx     InvestmentTransaction[]
  loans            Loan[]
  recurring        RecurringPayment[]
  repayments       Repayment[]
  transactionsTo   Transaction[]           @relation("DestinationAccount")
  transactionsFrom Transaction[]           @relation("SourceAccount")
}

model Category {
  id                String             @id @default(cuid())
  userId            String
  name              String
  type              String
  icon              String?
  color             String?
  isDefault         Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  isActive          Boolean            @default(true)
  slug              String?
  budgets           Budget[]
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchants         Merchant[]
  recurringPayments RecurringPayment[]
  transactions      Transaction[]
}

model Merchant {
  id                String        @id @default(cuid())
  userId            String
  name              String
  defaultCategoryId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  defaultCategory   Category?     @relation(fields: [defaultCategoryId], references: [id])
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
}

model Transaction {
  id                   String    @id @default(cuid())
  userId               String
  categoryId           String?
  merchantId           String?
  sourceAccountId      String?
  destinationAccountId String?
  type                 String
  amount               Decimal
  date                 DateTime  @default(now())
  description          String?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  category             Category? @relation(fields: [categoryId], references: [id])
  destinationAccount   Account?  @relation("DestinationAccount", fields: [destinationAccountId], references: [id])
  merchant             Merchant? @relation(fields: [merchantId], references: [id])
  sourceAccount        Account?  @relation("SourceAccount", fields: [sourceAccountId], references: [id])
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Loan {
  id           String      @id @default(cuid())
  userId       String
  accountId    String
  type         String      @default("LENT")
  borrowerName String
  amount       Decimal
  lentDate     DateTime
  dueDate      DateTime?
  status       String      @default("OUTSTANDING")
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  account      Account     @relation(fields: [accountId], references: [id])
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  repayments   Repayment[]
}

model Repayment {
  id        String   @id @default(cuid())
  loanId    String
  accountId String
  amount    Decimal
  paidDate  DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id])
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model Investment {
  id            String                  @id @default(cuid())
  userId        String
  name          String
  type          String
  platform      String?
  totalInvested Decimal                 @default(0.0)
  currentValue  Decimal                 @default(0.0)
  purchaseDate  DateTime?
  status        String                  @default("ACTIVE")
  notes         String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  realizedGain  Decimal                 @default(0.0)
  cashBalance   Decimal                 @default(0.0)
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  InvestmentTransaction[]
}

model InvestmentTransaction {
  id           String     @id @default(cuid())
  investmentId String
  accountId    String?
  type         String
  amount       Decimal
  date         DateTime   @default(now())
  notes        String?
  createdAt    DateTime   @default(now())
  account      Account?   @relation(fields: [accountId], references: [id])
  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
}

model RecurringPayment {
  id           String   @id @default(cuid())
  userId       String
  accountId    String
  categoryId   String
  name         String
  type         String
  amount       Decimal
  billingCycle String
  nextDueDate  DateTime
  reminderDays Int      @default(3)
  status       String   @default("ACTIVE")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  account      Account  @relation(fields: [accountId], references: [id])
  category     Category @relation(fields: [categoryId], references: [id])
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  amount     Decimal
  month      Int
  year       Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  category   Category @relation(fields: [categoryId], references: [id])
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
}

model Goal {
  id            String    @id @default(cuid())
  userId        String
  name          String
  targetAmount  Decimal
  currentAmount Decimal   @default(0.0)
  deadline      DateTime?
  color         String?
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  type        String
  title       String
  message     String
  scheduledAt DateTime?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MobileSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  deviceInfo String?
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
